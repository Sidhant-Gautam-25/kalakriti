# ============================================
# EXPRESS BACKEND SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# ============================================
# DATABASE
# Local MongoDB: mongodb://127.0.0.1:27017/artisan-market
# Atlas MongoDB: mongodb+srv://<username>:<password>@cluster.mongodb.net/artisan-market
# ============================================
MONGODB_URI=mongodb://127.0.0.1:27017/artisan-market

# ============================================
# GOOGLE GEMINI AI (Get free key from https://aistudio.google.com/)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# SECURITY & SECRETS
# ============================================
# Used to cryptographically sign AI catalog drafts before confirming a product
CATALOG_DRAFT_SECRET=use_a_long_random_secret_here

# Used by the WhatsApp provider / webhook route
WHATSAPP_BOT_SECRET=another_long_random_secret_here

# ============================================
# CLOUDINARY IMAGE STORAGE (Get free keys from https://cloudinary.com/)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# RAZORPAY PAYMENTS (Get free test keys from https://dashboard.razorpay.com/)
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================
# FASTAPI PYTHON SERVER CONFIGURATION
# ============================================
FASTAPI_PORT=8000
HOST=0.0.0.0

# AI Provider Configuration
# Supported providers can be configured here (e.g., google, openai)
AI_PROVIDER=google
